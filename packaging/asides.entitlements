<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks the microphone unless the app declares it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- And Apple events: New Agent Session opens agents in a new tab of Ghostty through AppleScript
	     (macOS asks the user first; without it, they open in a new window). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
